# Postgres
POSTGRES_DB=mikki_shop
POSTGRES_USER=mikki_shop
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://mikki_shop:change-me@127.0.0.1:5433/mikki_shop

# Redis
REDIS_URL=redis://127.0.0.1:6379

# In docker-compose, the api container overrides both to the postgres/redis
# service hostnames — see docker-compose.yml.

# API
PORT=3001
# Подписывает JWT покупателей. Длинная случайная строка — не только в проде:
# за туннелем (см. README, «Открыть в Telegram») API виден из интернета,
# и `change-me` означает, что токен покупателя подделает кто угодно.
JWT_SECRET=change-me

# Telegram
# Токен бота из @BotFather. Им проверяется подпись initData от Mini App:
# без него вход через Telegram выключен целиком, а не «пускает всех».
TELEGRAM_BOT_TOKEN=123456:PUT-YOUR-BOT-TOKEN-HERE
# Куда бот шлёт заявки о новых заказах. Свой id можно узнать у @userinfobot.
# Не задан — заявки пишутся в лог сервера, заказы при этом оформляются.
# Он же по умолчанию решает, чьи нажатия кнопок статуса принимать.
MANAGER_CHAT_ID=
# Владелец магазина: единственный, кто приглашает и снимает менеджеров
# (`/invite`, `/admins` в боте). Только отсюда — право раздавать доступ нельзя
# получить из самой системы, иначе первый приглашённый разжаловал бы
# пригласившего. Не задан — берётся `MANAGER_CHAT_ID`, если это личный чат.
OWNER_TELEGRAM_ID=
# Запасной список тех, кому можно менять статусы, через запятую. Обычно пуст:
# менеджеры заводятся приглашением через бота и живут в базе. Нужен, если база
# недоступна или роли перепутаны, — снимается только правкой файла.
ADMIN_TELEGRAM_IDS=
# Адрес Mini App для кнопки «Открыть магазин» под приветствием бота. Только
# HTTPS (Telegram другого не принимает); за туннелем это адрес из `docker
# compose logs tunnel`. Пусто — приветствие уходит без кнопки.
WEBAPP_URL=
# Опрос обновлений Telegram (`getUpdates`). `off` выключает бота, не трогая
# отправку заявок. Экземпляр должен быть ровно один: два процесса с одним
# токеном разбирают очередь обновлений наперегонки.
BOT_POLLING=on

# telegram-app (build-time, injected into the static bundle)
# Относительный путь, а не хост API: и Vite в dev, и nginx в контейнере
# проксируют /api на NestJS, поэтому фронт всегда ходит на свой origin.
# Так же он работает под HTTPS-туннелем, где отдельный http-хост API
# браузер Telegram зарежет как mixed content.
VITE_API_URL=/api
