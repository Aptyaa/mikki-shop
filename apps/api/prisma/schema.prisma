generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// Покупатель. Заводится сам при первом входе из Mini App — регистрации в
/// магазине нет и не будет: Telegram уже знает, кто это.
model User {
  id           String   @id @default(uuid())
  /// Идентификатор в Telegram. Строкой, а не числом: он давно вырос за пределы
  /// int32, а арифметики по нему всё равно нет.
  telegramId   String   @unique
  /// Профиль из `initData`. Всё необязательное: username может быть не задан,
  /// фамилия и фото — тем более, а язык приходит не всегда.
  username     String?
  firstName    String?
  lastName     String?
  photoUrl     String?
  languageCode String?
  isPremium    Boolean  @default(false)
  /// Источник перехода из `start_param` deep-link (см. «Аналитика воронки» в
  /// ARCHITECTURE.md). Пишется один раз, при первом входе: иначе переход по
  /// чужой ссылке переписал бы источник, который реально привёл покупателя.
  utmSource    String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
}

model Category {
  id        String    @id @default(uuid())
  key       String    @unique
  label     String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  /// Целые рубли, без копеек — так же, как цена показывается в интерфейсе.
  price      Int
  wasPrice   Int?
  tag        String?
  tagTone    String?
  soldOut    Boolean  @default(false)
  /// Заметка об остатке, если он мал: «Остался последний размер S».
  stockNote  String?
  /// Вес для сортировки «Популярные».
  popularity Int      @default(0)
  createdAt  DateTime @default(now())

  // Поля ниже нужны только карточке товара — в выдаче каталога они не читаются.
  /// Абзац описания. Один-два предложения по правилам бренда, без восклицаний.
  description String?
  /// Состав: «меринос 70%, акрил 30%».
  composition String?
  /// Уход одной строкой.
  care        String?
  /// Средняя оценка. Звёзды на экране показываются только от трёх отзывов.
  rating      Float?
  reviewCount Int      @default(0)
  /// URL фотографий по порядку. Пока пусто у всех: съёмки ещё не было.
  photos      String[]

  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id])
  sizes      ProductSize[]
  colors     ProductColor[]

  @@index([categoryId])
}

/// Размер товара: остаток и мерки.
///
/// Отдельная таблица вместо массива строк в `Product.sizes`: карточке нужно
/// знать остаток по каждому размеру (иначе `SizeSelector` нечем зачеркнуть) и
/// мерки для таблицы размеров. Держать рядом массив и таблицу — значит завести
/// два источника правды, которые разъедутся.
model ProductSize {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  /// Остаток в штуках. Ноль — размер остаётся в сетке зачёркнутым, а не прячется.
  quantity  Int     @default(0)
  /// Мерки в сантиметрах, диапазоном: «34–40». Строкой, а не числом: в таблице
  /// размеров это диапазон, и считать по нему нечего.
  chestCm   String?
  neckCm    String?
  backCm    String?

  @@unique([productId, size])
  @@index([productId])
}

/// Расцветка товара. `hex` — цвет ткани, а не интерфейса: токены его не описывают.
model ProductColor {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  sortOrder Int     @default(0)

  @@unique([productId, name])
  @@index([productId])
}
