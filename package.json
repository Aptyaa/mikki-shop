{
  "name": "mikki-shop",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:telegram-app": "pnpm --filter telegram-app dev",
    "build": "pnpm --filter shared-types build && pnpm --filter ui build && pnpm -r --filter=./apps/* build",
    "typecheck": "pnpm -r typecheck"
  }
}
