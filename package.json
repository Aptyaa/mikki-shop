{
  "name": "mikki-shop",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --filter shared-types build",
    "dev:api": "pnpm --filter api dev",
    "dev:telegram-app": "pnpm --filter telegram-app dev",
    "build": "pnpm --filter shared-types build && pnpm --filter ui build && pnpm -r --filter=./apps/* build",
    "lint": "oxlint --config _adherence.oxlintrc.json packages/ui/src apps/telegram-app/src",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "oxlint": "^1.16.0",
    "vitest": "^3.2.7"
  }
}
